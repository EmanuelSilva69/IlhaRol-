# Copie este arquivo para .env e ajuste os valores locais.
# Nunca versione o .env com credenciais reais.

POSTGRES_DB=ilharole
POSTGRES_USER=ilharole
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_HOST=db
POSTGRES_PORT=5432

API_PORT=8000
WEB_PORT=5173

# Origem autorizada a chamar a API pelo navegador
CORS_ORIGINS=http://localhost:5173

# Chave da API de Basemaps da CARTO (preencha no .env local; nunca versione)
CARTO_API_KEY=

# Pool de conexões da API (SQLAlchemy/asyncpg)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5
# Use 0 se a API apontar para o PgBouncer em pool_mode=transaction
DB_STATEMENT_CACHE_SIZE=100
DB_APPLICATION_NAME=ilharole-api

# Papéis de menor privilégio criados na inicialização do volume
ILHAROLE_APP_USER=ilharole_app
ILHAROLE_APP_PASSWORD=change-me-app
ILHAROLE_READONLY_USER=ilharole_readonly
ILHAROLE_READONLY_PASSWORD=change-me-readonly

# Fuso usado no PostgreSQL e nos backups
TZ=America/Fortaleza

# Porta local do Postgres no host (binda em 127.0.0.1)
POSTGRES_EXPOSE_PORT=5432

# Perfis opcionais: tools, pool, observability e backup
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@ilharole.dev
PGADMIN_PASSWORD=change-me-pgadmin

PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=session
PGBOUNCER_MAX_CLIENT_CONN=100
PGBOUNCER_DEFAULT_POOL_SIZE=20

POSTGRES_EXPORTER_PORT=9187

BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
